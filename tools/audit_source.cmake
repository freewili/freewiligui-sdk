if(NOT DEFINED SOURCE_DIR OR NOT DEFINED TERMS_FILE)
    message(FATAL_ERROR "SOURCE_DIR and TERMS_FILE are required")
endif()
if(NOT EXISTS "${TERMS_FILE}")
    message(FATAL_ERROR "terms file does not exist")
endif()
file(STRINGS "${TERMS_FILE}" terms)
file(GLOB_RECURSE files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*")
set(matches "")
foreach(file IN LISTS files)
    if(file MATCHES "^\\.git/" OR IS_DIRECTORY "${SOURCE_DIR}/${file}")
        continue()
    endif()
    string(TOLOWER "${file}" lower_path)
    file(READ "${SOURCE_DIR}/${file}" content)
    string(TOLOWER "${content}" lower_content)
    foreach(term IN LISTS terms)
        string(STRIP "${term}" term)
        if(term STREQUAL "")
            continue()
        endif()
        string(TOLOWER "${term}" lower_term)
        string(FIND "${lower_path}" "${lower_term}" path_pos)
        string(FIND "${lower_content}" "${lower_term}" content_pos)
        if(NOT path_pos EQUAL -1 OR NOT content_pos EQUAL -1)
            list(APPEND matches "${file}")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES matches)
if(matches)
    list(JOIN matches "\n  " display)
    message(FATAL_ERROR "source deny-list match:\n  ${display}")
endif()
message(STATUS "source privacy audit passed")
